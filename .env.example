# ==========================================
# SkillSync Backend Environment Configuration
# ==========================================

# Application Settings
APP_NAME="SkillSync API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
BASE_URL="http://localhost:8000"

# PostgreSQL Database
# For local Postgres:
DATABASE_URL="postgresql+psycopg://postgres:2040@localhost:5432/apollo-skillsync"
# If using Docker Compose (docker-compose.yml):
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/kaushallens"

# Redis (Optional / Future Caching & Queues)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"

# Security & JWT Authentication
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN=30
JWT_REFRESH_TOKEN=7
